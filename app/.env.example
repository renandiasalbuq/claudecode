# Copie para .env.local em desenvolvimento. Em produção, cadastre na Vercel.
# NUNCA faça commit dos valores reais.

# URL pública do app (sem barra no final)
APP_URL=https://seu-app.vercel.app

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sessão: segredo longo e aleatório (ex.: openssl rand -hex 32)
SESSION_SECRET=

# Webhook da Cakto
# Token que vai na URL: /api/webhook/cakto?token=...
CAKTO_WEBHOOK_TOKEN=
# "secret" gerado pela Cakto ao criar o webhook (valida a assinatura X-Cakto-Signature)
CAKTO_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Reserva de Emergência do Zero <acesso@seudominio.com.br>"
EMAIL_SUPORTE=

# Só para desenvolvimento local sem Supabase/Resend: memoria | supabase
DB_DRIVER=supabase
